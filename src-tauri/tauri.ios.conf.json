{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "1.0.0",
  "identifier": "app.argus.mobile.ios",
  "build": {
    "beforeDevCommand": "pnpm dev --mode mobile",
    "beforeBuildCommand": "pnpm build:desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "fullscreen": true,
        "resizable": true,
        "backgroundColor": [8, 9, 10, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval' https: http: data: blob:;"
    }
  },
  "bundle": {
    "category": "Entertainment",
    "iOS": {
      "minimumSystemVersion": "16.0",
      "frameworks": ["AVKit.framework", "AVFoundation.framework", "MediaPlayer.framework"],
      "developmentTeam": ""
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": []
    }
  }
}

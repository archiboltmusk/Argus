{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.2.0",
  "identifier": "app.argus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Argus",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Entertainment",
    "shortDescription": "Fast streaming hub for your own sources",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "mkv",
          "mp4",
          "avi",
          "mov",
          "m4v",
          "webm",
          "ts",
          "m2ts",
          "wmv",
          "flv",
          "mpg",
          "mpeg"
        ],
        "name": "Video",
        "role": "Viewer",
        "mimeType": "video/*"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_CI_FROM_TAURI_UPDATER_PUBKEY",
      "endpoints": [
        "https://github.com/archiboltmusk/Argus/releases/download/beta/latest.json"
      ]
    }
  }
}

# Force GGML/whisper.cpp to build portable baseline ARM code without host-specific i8mm
set(GGML_NATIVE OFF CACHE BOOL "Force disable GGML_NATIVE" FORCE)
set(WHISPER_NATIVE OFF CACHE BOOL "Force disable WHISPER_NATIVE" FORCE)
set(GGML_MACHINE_SUPPORTS_i8mm OFF CACHE BOOL "Disable i8mm" FORCE)
set(GGML_MACHINE_SUPPORTS_sve OFF CACHE BOOL "Disable sve" FORCE)
set(GGML_CPU_ARM_ARCH "armv8-a" CACHE STRING "Target baseline armv8-a" FORCE)
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -U__ARM_FEATURE_MATMUL_INT8" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -U__ARM_FEATURE_MATMUL_INT8" CACHE STRING "" FORCE)
